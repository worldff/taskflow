# Salin menjadi .env lalu sesuaikan nilainya (jangan commit file .env)
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=ganti-password-db
SECRET_KEY=ganti-dengan-secret-acak-minimal-32-karakter
APP_ENV=production
# Akun admin awal (dibuat otomatis saat backend start). Ganti password untuk production.
ADMIN_EMAIL=admin@taskflow.id
ADMIN_PASSWORD=admin123
APP_PORT=8080
APP_VERSION=1.0.0
# Saat deploy dari registry (diisi otomatis oleh pipeline CD):
# BACKEND_IMAGE=ghcr.io/<username>/taskflow-backend:latest
# FRONTEND_IMAGE=ghcr.io/<username>/taskflow-frontend:latest
