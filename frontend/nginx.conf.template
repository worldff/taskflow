# Template Nginx: ${BACKEND_URL} diisi otomatis dari environment saat container start.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Kompresi & header keamanan dasar
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options DENY;

    # Reverse proxy: semua request /api diteruskan ke container backend
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Aset hasil build diberi cache panjang (nama file sudah ber-hash)
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Fallback SPA: semua route lain diarahkan ke index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
